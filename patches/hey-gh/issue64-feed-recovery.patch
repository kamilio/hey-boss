+    c.refresh_pr_status(Freshness::Revalidate, true)
+        .await
+        .unwrap();
+    c.refresh_pr_status(Freshness::Revalidate, false)
+        .await
+        .unwrap();
+    let broken = c
+        .pr_status_page(Some("acme/demo"), None, 1000, Duration::ZERO)
+        .await
+        .unwrap();
