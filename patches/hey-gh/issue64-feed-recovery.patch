+            Duration::ZERO,
+        )
+        .await
+        .unwrap();
+    let row = &recovered
+        .changes
+        .last()
+        .expect("CI recovery replacement")
+        .pull_request;
+    assert!(row["sourceErrors"]["ci"].is_null());
+    assert!(row["sourceErrors"]["details"].is_string());
+    assert_eq!(row["complete"], false);
+}
